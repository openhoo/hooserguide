{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "fullPage": {
      "type": "boolean"
    },
    "focus": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "css": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "css"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "role",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "testId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "testId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "padding": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500
    },
    "autoLabels": {
      "type": "string",
      "enum": [
        "numbers",
        "letters"
      ]
    },
    "masks": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "css": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "css"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "testId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "testId"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "css": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "css"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "role",
                  "name"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "label"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "testId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "testId"
                ],
                "additionalProperties": false
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "box",
              "arrow",
              "both"
            ]
          },
          "label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{1,4}$"
          },
          "caption": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "leader": {
            "description": "Connect a reference badge to its target. With from, the badge center is fixed; omit side and length.",
            "type": "object",
            "properties": {
              "side": {
                "description": "Side of the target for the reference badge. The default is auto.",
                "type": "string",
                "enum": [
                  "auto",
                  "left",
                  "right",
                  "top",
                  "bottom"
                ]
              },
              "length": {
                "description": "Distance from badge rim to arrow tip in CSS pixels (default 72).",
                "type": "number",
                "minimum": 12,
                "maximum": 2000
              },
              "width": {
                "description": "Stroke width in CSS pixels (default 2). Use 1 for a fine line.",
                "type": "number",
                "minimum": 0.5,
                "maximum": 6
              },
              "headSize": {
                "description": "Length of the arrowhead in CSS pixels (default 9).",
                "type": "number",
                "minimum": 4,
                "maximum": 24
              },
              "head": {
                "description": "Open outline or filled arrowhead. The default is filled.",
                "type": "string",
                "enum": [
                  "open",
                  "filled"
                ]
              }
            },
            "additionalProperties": false
          },
          "from": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "target"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
