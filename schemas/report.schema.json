{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "responsive": {
      "type": "object",
      "properties": {
        "profiles": {
          "minItems": 2,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "layout": {
          "type": "string",
          "enum": [
            "side-by-side",
            "stacked"
          ]
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      },
      "required": [
        "profiles"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "language": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "browser": {
      "type": "string",
      "enum": [
        "chromium",
        "firefox",
        "webkit"
      ]
    },
    "exportError": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "branding": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      },
      "additionalProperties": false
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "rebuiltAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "sourceReportSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "document": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "productVersion": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "manual": {
      "type": "object",
      "properties": {
        "pageSize": {
          "type": "string",
          "enum": [
            "A4",
            "Letter"
          ]
        },
        "orientation": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "margin": {
          "type": "number",
          "minimum": 24,
          "maximum": 72
        },
        "contents": {
          "type": "boolean"
        },
        "showGeneratedAt": {
          "type": "boolean"
        },
        "screenLayout": {
          "type": "string",
          "enum": [
            "side-by-side",
            "stacked"
          ]
        }
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "tagExpression": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "skippedScenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "feature": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "fail-fast",
              "cancelled"
            ]
          }
        },
        "required": [
          "title",
          "feature",
          "source",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "chapters": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variant": {
            "type": "object",
            "properties": {
              "scenario": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "profile": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "browser": {
                "type": "string",
                "enum": [
                  "chromium",
                  "firefox",
                  "webkit"
                ]
              },
              "viewport": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 320,
                    "maximum": 9007199254740991
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 240,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "deviceScaleFactor": {
                "type": "number",
                "minimum": 1,
                "maximum": 4
              }
            },
            "required": [
              "scenario",
              "profile",
              "label",
              "browser",
              "viewport",
              "deviceScaleFactor"
            ],
            "additionalProperties": false
          },
          "title": {
            "type": "string"
          },
          "feature": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "error": {
            "type": "string"
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "callouts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "note",
                    "tip",
                    "warning"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "passed",
                    "failed"
                  ]
                },
                "error": {
                  "type": "string"
                },
                "durationMs": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "text",
                "status"
              ],
              "additionalProperties": false
            }
          },
          "captures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "image": {
                  "type": "string",
                  "pattern": "^screenshots\\/[A-Za-z0-9_-]+(?:\\.raw)?\\.png$"
                },
                "raw": {
                  "type": "string",
                  "pattern": "^screenshots\\/[A-Za-z0-9_-]+(?:\\.raw)?\\.png$"
                },
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "rawSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "marks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "target": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "object",
                            "properties": {
                              "css": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "css"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "role": {
                                "type": "string",
                                "minLength": 1
                              },
                              "name": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "role",
                              "name"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "label"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "text": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "text"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "testId": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "testId"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "box",
                          "arrow",
                          "both"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9]{1,4}$"
                      },
                      "caption": {
                        "type": "string"
                      },
                      "color": {
                        "type": "string",
                        "pattern": "^#[0-9a-f]{6}$"
                      },
                      "from": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number",
                            "minimum": 0
                          },
                          "y": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "x",
                          "y"
                        ],
                        "additionalProperties": false
                      },
                      "bounds": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number",
                            "minimum": 0
                          },
                          "y": {
                            "type": "number",
                            "minimum": 0
                          },
                          "width": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "height": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "width",
                          "height"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "target",
                      "bounds"
                    ],
                    "additionalProperties": false
                  }
                },
                "crop": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0
                    },
                    "width": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "height": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "title",
                "image",
                "raw",
                "width",
                "height",
                "sha256",
                "marks"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "feature",
          "source",
          "tags",
          "description",
          "status",
          "instructions",
          "steps",
          "captures"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "generatedAt",
    "language",
    "status",
    "browser",
    "chapters"
  ],
  "additionalProperties": false
}
