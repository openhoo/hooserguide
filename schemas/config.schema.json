{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "baseURL": {
      "type": "string",
      "format": "uri"
    },
    "features": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output": {
      "default": "output",
      "type": "string",
      "minLength": 1
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "deviceScaleFactor": {
      "type": "number",
      "minimum": 1,
      "maximum": 4
    },
    "browser": {
      "type": "string",
      "enum": [
        "chromium",
        "firefox",
        "webkit"
      ]
    },
    "headed": {
      "type": "boolean"
    },
    "storageState": {
      "type": "string"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 120000
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "masks": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "css": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "css"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "testId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "testId"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "tag": {
      "type": "string",
      "pattern": "^@[\\w-]+$"
    },
    "tagExpression": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "failFast": {
      "type": "boolean"
    },
    "document": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "productVersion": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "manual": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string",
          "enum": [
            "professional",
            "ocean",
            "forest",
            "sand",
            "midnight",
            "graphite"
          ]
        },
        "pageSize": {
          "type": "string",
          "enum": [
            "A4",
            "Letter"
          ]
        },
        "orientation": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "margin": {
          "type": "number",
          "minimum": 24,
          "maximum": 72
        },
        "contents": {
          "type": "boolean"
        },
        "showGeneratedAt": {
          "type": "boolean"
        },
        "screenLayout": {
          "type": "string",
          "enum": [
            "side-by-side",
            "stacked"
          ]
        }
      },
      "additionalProperties": false
    },
    "captureDefaults": {
      "type": "object",
      "properties": {
        "fullPage": {
          "type": "boolean"
        },
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "autoLabels": {
          "type": "string",
          "enum": [
            "numbers",
            "letters"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      },
      "additionalProperties": false
    },
    "language": {
      "default": "en",
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
    },
    "pdf": {
      "default": true,
      "type": "boolean"
    },
    "responsive": {
      "type": "object",
      "properties": {
        "profiles": {
          "minItems": 2,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "layout": {
          "type": "string",
          "enum": [
            "side-by-side",
            "stacked"
          ]
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      },
      "required": [
        "profiles"
      ],
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "viewport": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 320,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "minimum": 240,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "deviceScaleFactor": {
            "type": "number",
            "minimum": 1,
            "maximum": 4
          },
          "browser": {
            "type": "string",
            "enum": [
              "chromium",
              "firefox",
              "webkit"
            ]
          },
          "isMobile": {
            "type": "boolean"
          },
          "hasTouch": {
            "type": "boolean"
          },
          "colorScheme": {
            "type": "string",
            "enum": [
              "light",
              "dark",
              "no-preference"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "branding": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "title",
    "baseURL",
    "features",
    "output",
    "language",
    "pdf"
  ],
  "additionalProperties": false
}
