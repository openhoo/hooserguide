{
  "title": "HooTasks — Responsive user guide",
  "baseURL": "http://127.0.0.1:31415",
  "features": ["tasks.feature"],
  "output": "../output/pages-demo",
  "masks": ["testid=account-email"],
  "tag": "@manual",
  "manual": { "orientation": "landscape" },
  "profiles": {
    "desktop": { "viewport": { "width": 1280, "height": 900 } },
    "tablet": { "viewport": { "width": 768, "height": 1024 }, "hasTouch": true },
    "mobile": {
      "viewport": { "width": 390, "height": 844 },
      "isMobile": true,
      "hasTouch": true,
      "deviceScaleFactor": 2
    }
  },
  "responsive": {
    "profiles": ["desktop", "tablet", "mobile"],
    "layout": "side-by-side",
    "labels": { "desktop": "Desktop", "tablet": "Tablet", "mobile": "Mobile" }
  }
}
